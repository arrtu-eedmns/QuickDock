{
  "manifest_version": 3,
  "name": "QuickDock",
  "version": "2.1.0",
  "key": "",
  "description": "Workspace lateral persistente para produtividade operacional.",
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Q"
      },
      "description": "Abrir/fechar QuickDock"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "identity"
  ],
  "oauth2": {
    "client_id": "324044251913-1ftlbp9ip7g9mhv3iuum47hl0tuq41md.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Abrir QuickDock",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
